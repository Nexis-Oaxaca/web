---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NosotrosHero from '../components/NosotrosHero.astro';
import HistoriaSection from '../components/HistoriaSection.astro';
import MisionVision from '../components/MisionVision.astro';
import ValoresSection from '../components/ValoresSection.astro';
import AreasInteres from '../components/AreasInteres.astro';
import ActividadesSection from '../components/ActividadesSection.astro';
import LiderazgoSection from '../components/LiderazgoSection.astro';
import VoluntariadoSection from '../components/VoluntariadoSection.astro';
import CierreSection from '../components/CierreSection.astro';
import { getTeamMembers, getEvents, getProjects } from '../lib/cms';
import {
  Star,
  Zap,
  Share2,
  Compass,
  HeartHandshake,
  BookOpen,
  Heart,
  Lightbulb,
  Users,
  RefreshCw,
  Code,
  Cloud,
  Bot,
  Palette,
  Wifi,
  Cpu,
  Briefcase,
  Globe,
  Calendar,
  Layers,
  Network,
  GraduationCap,
  Building2,
} from 'lucide-astro';

const [team, events, projects] = await Promise.all([
  getTeamMembers(),
  getEvents(),
  getProjects(),
]);

const timeline = [
  { year: 'Mayo 2026', title: 'La primera chispa', description: 'Un grupo de amigos notó que en Oaxaca faltaba un lugar donde juntarse a hablar de tecnología. Ese día se decidió intentarlo.', icon: Star },
  { year: 'Julio 2026', title: 'La primera experiencia', description: 'La primera charla reunió a personas con ganas de explorar tecnología. La idea empezó a tomar forma al encontrarnos.', icon: Zap },
];

const valores = [
  { icon: HeartHandshake, title: 'Colaboración', description: 'Lo que uno no sabe, otro lo explica. Así crecemos todos.', color: 'jade' },
  { icon: BookOpen, title: 'Aprendizaje continuo', description: 'Aquí no hay expertos perfectos: hay personas con curiosidad.', color: 'ambar' },
  { icon: Heart, title: 'Cercanía', description: 'Nos apoyamos, nos animamos y celebramos juntos cada paso.', color: 'coral' },
  { icon: Lightbulb, title: 'Probar sin miedo', description: 'Nos gusta intentar cosas nuevas y aprender del intento.', color: 'petroleo' },
  { icon: Users, title: 'Aquí cabe todo el mundo', description: 'Sin importar de dónde vengas ni cuánto sepas, tu lugar está aquí.', color: 'jade' },
  { icon: RefreshCw, title: 'Lo que sabes, se comparte', description: 'Si aprendiste algo, seguro alguien más quiere aprenderlo contigo.', color: 'ambar' },
];

const areas = [
  { icon: Code, title: 'Desarrollo de Software', description: 'Crear apps, sitios y herramientas con las manos.', color: 'jade' },
  { icon: Cloud, title: 'Cloud Computing', description: 'Servidores, infraestructura y el mundo de "lo de la nube".', color: 'petroleo' },
  { icon: Bot, title: 'Inteligencia Artificial', description: 'Modelos, LLMs y todo lo que se aprende con datos.', color: 'coral' },
  { icon: Palette, title: 'UX/UI', description: 'Diseñar experiencias pensadas en las personas.', color: 'ambar' },
  { icon: Wifi, title: 'IoT', description: 'Cosas conectadas y hardware con ideas.', color: 'jade' },
  { icon: Cpu, title: 'Robótica', description: 'Máquinas que hacen cosas y todo lo que hay detrás.', color: 'petroleo' },
  { icon: Briefcase, title: 'Emprendimiento', description: 'Convertir una idea en algo real.', color: 'coral' },
  { icon: Globe, title: 'Ciberseguridad', description: 'Proteger datos y entender el lado oscuro de la red.', color: 'ambar' },
];

const actividades = [
  { icon: Calendar, title: 'Charlas', description: 'Pláticas de gente real contando lo que aprende.', stat: `${events.length}+` },
  { icon: Layers, title: 'Talleres', description: 'Aprender haciendo, no solo escuchando.' },
  { icon: Network, title: 'Encuentros', description: 'Café, pláticas y conocer a gente con intereses parecidos.' },
  { icon: GraduationCap, title: 'Actividades educativas', description: 'Acercar experiencias tecnológicas a estudiantes.' },
  { icon: Building2, title: 'Colaboraciones', description: 'Actividades que construimos con otras personas e instituciones.' },
];

const volunteerReasons = [
  'Ayudar en la logística de los encuentros',
  'Difundir próximos encuentros en redes sociales',
  'Fotos y recuerdos de cada evento',
  'Organizar meetups y talleres',
  'Recibir a la gente nueva en la entrada',
  'Proponer y armar actividades nuevas',
];
---

<Layout title="Participa en Nexis Oaxaca" description="Conoce cómo participar en charlas, talleres, encuentros y colaboraciones de Nexis Oaxaca. No necesitas experiencia previa, solo curiosidad por la tecnología.">
  <Header />

  <main>
    <NosotrosHero eventsCount={events.length} />
    <HistoriaSection timeline={timeline} />
    <MisionVision eventsCount={events.length} />
    <ValoresSection valores={valores} />
    <AreasInteres areas={areas} />
    <ActividadesSection actividades={actividades} />
    <LiderazgoSection team={team} />
    <VoluntariadoSection volunteerReasons={volunteerReasons} />
    <CierreSection />
  </main>

  <Footer />
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const init = () => {
    const reveals = document.querySelectorAll('.reveal');
    gsap.set(reveals, { clearProps: "all" });
    reveals.forEach((el) => {
      gsap.from(el, {
        scrollTrigger: {
          trigger: el,
          start: "top 85%",
          toggleActions: "play none none none"
        },
        opacity: 0,
        y: 40,
        duration: 0.8,
        ease: "power3.out"
      });
    });
  };

  document.addEventListener('astro:page-load', () => {
    ScrollTrigger.getAll().forEach(t => t.kill());
    init();
  });
</script>
