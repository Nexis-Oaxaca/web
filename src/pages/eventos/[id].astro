---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RichText from "../../components/RichText.astro";
import EventCard from "../../components/EventCard.astro";
import { getEventBySlug, getEvents } from "../../lib/cms";
import { richTextToText } from "../../lib/cms/rich-text";
import {
  ArrowLeft,
  ArrowUpRight,
  CalendarDays,
  Clock3,
  ExternalLink,
  Facebook,
  Instagram,
  Linkedin,
  MapPin,
  Monitor,
  Share2,
  X,
  ChevronLeft,
  ChevronRight,
} from "lucide-astro";

export async function getStaticPaths() {
  const events = await getEvents();
  return events.map((event) => ({ params: { id: event.slug }, props: { event } }));
}

const { event: staticEvent } = Astro.props;
const event = staticEvent ?? (await getEventBySlug(Astro.params.id || ""));
if (!event) throw new Error(`Evento no encontrado: ${Astro.params.id}`);

const parseEventDate = (dateStr: string) => {
  const value = dateStr?.trim();
  if (!value) return null;
  const normalized = value.includes("T") ? value : value.replace(" ", "T").replace(/\//g, "-");
  const date = new Date(normalized.includes("T") ? normalized : `${normalized}T00:00:00`);
  return Number.isNaN(date.getTime()) ? null : date;
};

const eventDate = parseEventDate(event.date);
const isPast = eventDate ? eventDate.getTime() < Date.now() : false;
const statusSource = event.status?.toLocaleLowerCase() ?? "";
const eventStatus = isPast || statusSource.includes("finalizado")
  ? "FINALIZADO"
  : statusSource.includes("cancel")
    ? "CANCELADO"
    : statusSource.includes("lleno")
      ? "CUPO LLENO"
      : statusSource.includes("curso")
        ? "EN CURSO"
        : event.registerLink || statusSource.includes("registro")
          ? "REGISTRO ABIERTO"
          : "PRÓXIMAMENTE";
const modalitySource = `${event.type ?? ""} ${event.location ?? ""}`.toLocaleLowerCase();
const modality = modalitySource.includes("híbrido") || modalitySource.includes("hibrido")
  ? "HÍBRIDO"
  : modalitySource.includes("virtual") || modalitySource.includes("línea") || modalitySource.includes("linea") || modalitySource.includes("remoto")
    ? "EN LÍNEA"
    : "PRESENCIAL";
const isOnline = modality === "EN LÍNEA";
const formattedDate = eventDate?.toLocaleDateString("es-MX", { day: "numeric", month: "long", year: "numeric", timeZone: "America/Mexico_City" }) ?? "Fecha por confirmar";
const formattedShortDate = eventDate?.toLocaleDateString("es-MX", { day: "2-digit", month: "short", year: "numeric", timeZone: "America/Mexico_City" }).replace(".", "").toUpperCase() ?? "FECHA POR CONFIRMAR";
const formattedTime = eventDate?.toLocaleTimeString("es-MX", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "America/Mexico_City" }) ?? "Por confirmar";
const descriptionText = richTextToText(event.description);
const summary = descriptionText.length > 220 ? `${descriptionText.slice(0, 217).trimEnd()}...` : descriptionText;
const speakers = event.speakers ?? [];
const gallery = event.gallery ?? [];
const recordingUrl = event.media?.youtube;
const socialLinks = [
  { label: "Facebook", url: event.media?.facebook, icon: Facebook },
  { label: "Instagram", url: event.media?.instagram, icon: Instagram },
  { label: "LinkedIn", url: event.media?.linkedin, icon: Linkedin },
].filter((item): item is { label: string; url: string; icon: typeof Facebook } => Boolean(item.url));
const allEvents = await getEvents();
const relatedEvents = allEvents.filter((item) => item.slug !== event.slug).slice(0, 3);
const getInitials = (name: string) => name.split(" ").filter(Boolean).map((word) => word[0]).join("").slice(0, 2).toUpperCase();
const eventUrl = new URL(`/eventos/${event.slug}`, Astro.url).toString();
const eventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: event.title,
  description: summary,
  startDate: eventDate?.toISOString(),
  eventStatus: isPast ? "https://schema.org/EventCompleted" : "https://schema.org/EventScheduled",
  eventAttendanceMode: isOnline ? "https://schema.org/OnlineEventAttendanceMode" : "https://schema.org/OfflineEventAttendanceMode",
  location: isOnline ? { "@type": "VirtualLocation", url: eventUrl } : { "@type": "Place", name: event.location || "Oaxaca" },
  image: [event.image],
  organizer: { "@type": "Organization", name: "Nexis Oaxaca", url: new URL("/", Astro.url).toString() },
  performer: speakers.map((speaker) => ({ "@type": "Person", name: speaker.name })),
};
---

<Layout title={`${event.title} | Nexis Oaxaca`} description={summary}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />

  <main class="bg-marfil pb-28 pt-28 sm:pt-32">
    <div class="mx-auto max-w-7xl px-6">
      <nav aria-label="Miga de pan" class="mb-10">
        <a href="/eventos" class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-petroleo/65 transition-colors duration-200 hover:text-jade focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-jade"><ArrowLeft class="h-4 w-4" />Todos los encuentros</a>
      </nav>

      <section class="grid gap-10 lg:grid-cols-[minmax(0,1.85fr)_minmax(20rem,1fr)] lg:gap-14" aria-labelledby="event-title">
        <div class="pt-1">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-md bg-petroleo px-3 py-1.5 text-[10px] font-bold tracking-[0.14em] text-white">{isPast ? "EVENTO FINALIZADO" : "PRÓXIMO ENCUENTRO"}</span>
            <span class="rounded-md border border-petroleo/15 px-3 py-1.5 text-[10px] font-bold tracking-[0.14em] text-petroleo">{modality}</span>
          </div>
          <h1 id="event-title" class="mt-6 max-w-3xl font-display text-4xl font-extrabold leading-[1.04] tracking-tight text-petroleo sm:text-5xl lg:text-6xl">{event.title}</h1>
          {summary && <p class="mt-6 max-w-2xl text-base leading-7 text-petroleo/75 sm:text-lg">{summary}</p>}
          <div class="mt-8 grid max-w-2xl grid-cols-2 gap-x-6 gap-y-4 border-y border-petroleo/10 py-5 text-sm text-petroleo sm:grid-cols-4">
            <div class="flex items-center gap-2"><CalendarDays class="h-4 w-4 shrink-0 text-jade" /><span>{formattedShortDate}</span></div>
            <div class="flex items-center gap-2"><Clock3 class="h-4 w-4 shrink-0 text-jade" /><span>{formattedTime} h</span></div>
            <div class="flex items-center gap-2"><Monitor class="h-4 w-4 shrink-0 text-jade" /><span>{modality}</span></div>
            <div class="flex items-center gap-2"><span class="h-2 w-2 shrink-0 rounded-full bg-jade" aria-hidden="true"></span><span>Gratuito</span></div>
          </div>
        </div>

        <aside class="lg:row-span-2">
          <div class="lg:sticky lg:top-28">
            <div class="overflow-hidden rounded-card border border-petroleo/12 bg-arena p-3">
              <img src={event.image} alt={`Imagen promocional de ${event.title}`} class="aspect-[4/3] w-full rounded-[16px] object-cover" transition:name={`event-image-${event.slug}`} />
            </div>
            <section class="mt-5 rounded-card border border-petroleo/12 bg-white p-6" aria-label="Resumen del evento">
              <p class="text-xs font-bold tracking-[0.14em] text-jade">{eventStatus}</p>
              <p class="mt-4 font-display text-2xl font-bold text-petroleo">{formattedDate}</p>
              <p class="mt-1 text-sm text-petroleo/70">{formattedTime} h · UTC-6</p>
              <div class="mt-5 border-t border-petroleo/10 pt-5 text-sm">
                <p class="font-semibold text-petroleo">{isOnline ? "En línea" : event.location || "Sede por confirmar"}</p>
                <p class="mt-1 text-petroleo/65">{isOnline ? "El acceso se comparte al registrarte" : "Oaxaca, México"}</p>
                <p class="mt-4 font-medium text-petroleo">Entrada gratuita</p>
              </div>
              <div class="mt-6 grid gap-3">
                {isPast && recordingUrl ? (
                  <a href={recordingUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-button bg-petroleo px-5 text-sm font-bold text-white transition-colors duration-200 hover:bg-jade focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-jade">Ver grabación <ExternalLink class="h-4 w-4" /></a>
                ) : !isPast && event.registerLink && eventStatus !== "CANCELADO" && eventStatus !== "CUPO LLENO" ? (
                  <a href={event.registerLink} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-button bg-petroleo px-5 text-sm font-bold text-white transition-colors duration-200 hover:bg-jade focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-jade">Registrarme <ArrowUpRight class="h-4 w-4" /></a>
                ) : !isPast ? (
                  <button type="button" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-button bg-petroleo px-5 text-sm font-bold text-white transition-colors duration-200 hover:bg-jade focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-jade" data-calendar-button data-calendar-title={event.title} data-calendar-date={eventDate?.toISOString()}><CalendarDays class="h-4 w-4" />Agregar al calendario</button>
                ) : null}
                {!isPast && event.registerLink && <button type="button" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-button border border-petroleo/15 px-5 text-sm font-semibold text-petroleo transition-colors duration-200 hover:border-jade hover:text-jade focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-jade" data-calendar-button data-calendar-title={event.title} data-calendar-date={eventDate?.toISOString()}><CalendarDays class="h-4 w-4" />Agregar al calendario</button>}
                <button type="button" class="inline-flex min-h-11 items-center justify-center gap-2 text-sm font-semibold text-petroleo/70 transition-colors duration-200 hover:text-jade focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-jade" data-share-button data-share-title={event.title} data-share-url={eventUrl}><Share2 class="h-4 w-4" />Compartir</button>
              </div>
              {!isPast && !event.registerLink && <p class="mt-4 text-xs leading-5 text-petroleo/60">El registro estará disponible próximamente.</p>}
            </section>
          </div>
        </aside>

        <div class="max-w-3xl space-y-16 lg:pt-4">
          <section aria-labelledby="about-event-title">
            <p class="text-xs font-bold tracking-[0.16em] text-jade">SOBRE EL ENCUENTRO</p>
            <h2 id="about-event-title" class="mt-3 font-display text-3xl font-bold text-petroleo">¿Qué exploraremos?</h2>
            <RichText content={event.description} class="mt-6 max-w-2xl text-base leading-8 text-petroleo/80 prose-headings:font-display prose-headings:text-petroleo prose-p:text-petroleo/80 prose-a:text-jade sm:text-lg" />
          </section>

          {speakers.length > 0 && (
            <section aria-labelledby="speakers-title">
              <p class="text-xs font-bold tracking-[0.16em] text-jade">SPEAKER</p>
              <h2 id="speakers-title" class="mt-3 font-display text-3xl font-bold text-petroleo">Conoce a quien nos acompaña</h2>
              <div class:list={["mt-7 grid gap-4", speakers.length > 1 ? "sm:grid-cols-2" : ""]}>
                {speakers.map((speaker) => (
                  <article class="flex gap-4 rounded-card border border-petroleo/10 bg-white p-5">
                    <div class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full bg-petroleo/10 font-display font-bold text-petroleo">
                      {speaker.image ? <img src={speaker.image} alt={speaker.name} class="h-full w-full object-cover" loading="lazy" /> : getInitials(speaker.name)}
                    </div>
                    <div class="min-w-0 pt-1"><h3 class="font-display text-lg font-bold text-petroleo">{speaker.name}</h3>{speaker.role && <p class="mt-1 text-sm leading-5 text-petroleo/65">{speaker.role}</p>}</div>
                  </article>
                ))}
              </div>
            </section>
          )}

          {isPast && (gallery.length > 0 || recordingUrl || socialLinks.length > 0) && (
            <section class="border-t border-petroleo/10 pt-14" aria-labelledby="memories-title">
              <p class="text-xs font-bold tracking-[0.16em] text-jade">MEMORIAS DEL ENCUENTRO</p>
              <h2 id="memories-title" class="mt-3 font-display text-3xl font-bold text-petroleo">Así vivimos este encuentro</h2>
              <p class="mt-4 max-w-2xl text-base leading-7 text-petroleo/70">Revive algunos momentos, consulta los materiales y descubre más sobre esta edición.</p>
              {gallery.length > 0 && (
                <div class="mt-8 grid h-[28rem] grid-cols-2 gap-3 sm:grid-cols-3" aria-label={`Galería de ${event.title}`}>
                  {gallery.map((image, index) => (
                    <button type="button" class:list={["gallery-trigger relative overflow-hidden rounded-[16px] bg-arena text-left focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-jade", index > 2 ? "hidden" : "", index === 0 ? "row-span-2" : ""]} data-gallery-index={index} data-gallery-src={image} data-gallery-alt={`Foto ${index + 1} de ${event.title}`} aria-label={`Ampliar foto ${index + 1} de ${gallery.length}`}>
                      <img src={image} alt={`Foto ${index + 1} de ${event.title}`} class="h-full w-full object-cover" loading="lazy" />
                      {index === 2 && gallery.length > 3 && <span class="absolute inset-0 flex items-center justify-center bg-petroleo/65 text-sm font-bold text-white">+{gallery.length - 3} fotos</span>}
                    </button>
                  ))}
                </div>
              )}
              {(recordingUrl || socialLinks.length > 0) && <div class="mt-8"><h3 class="font-display text-xl font-bold text-petroleo">Recursos</h3><div class="mt-4 flex flex-wrap gap-3">{recordingUrl && <a href={recordingUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 rounded-button border border-petroleo/15 px-4 text-sm font-semibold text-petroleo transition-colors duration-200 hover:border-jade hover:text-jade">Ver grabación <ExternalLink class="h-4 w-4" /></a>}</div></div>}
              {socialLinks.length > 0 && <div class="mt-8 border-t border-petroleo/10 pt-6"><h3 class="font-display text-xl font-bold text-petroleo">Más sobre este encuentro</h3><div class="mt-4 flex flex-wrap gap-4">{socialLinks.map(({ label, url, icon: Icon }) => <a href={url} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-petroleo/70 transition-colors duration-200 hover:text-jade focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-jade"><Icon class="h-4 w-4" />{label}<ExternalLink class="h-3.5 w-3.5" /></a>)}</div></div>}
            </section>
          )}
        </div>
      </section>

      {relatedEvents.length > 0 && <section class="mt-24 border-t border-petroleo/10 pt-12" aria-labelledby="related-events-title"><p class="text-xs font-bold tracking-[0.16em] text-jade">SIGUE EXPLORANDO</p><h2 id="related-events-title" class="mt-3 font-display text-3xl font-bold text-petroleo">También podría interesarte</h2><div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">{relatedEvents.map((relatedEvent) => <EventCard event={relatedEvent} past={(parseEventDate(relatedEvent.date)?.getTime() ?? 0) < Date.now()} />)}</div></section>}
    </div>
  </main>

  {!isPast && <div class="fixed inset-x-0 bottom-0 z-40 border-t border-petroleo/10 bg-marfil/95 px-4 py-3 backdrop-blur lg:hidden"><div class="mx-auto flex max-w-md items-center justify-between gap-4"><p class="text-xs font-semibold text-petroleo"><span class="block">{formattedShortDate}</span><span class="text-petroleo/65">{formattedTime} h</span></p>{event.registerLink ? <a href={event.registerLink} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center justify-center rounded-button bg-petroleo px-5 text-sm font-bold text-white">Registrarme</a> : <button type="button" class="inline-flex min-h-11 items-center justify-center rounded-button bg-petroleo px-5 text-sm font-bold text-white" data-calendar-button data-calendar-title={event.title} data-calendar-date={eventDate?.toISOString()}>Calendario</button>}</div></div>}

  {gallery.length > 0 && <dialog id="gallery-modal" class="m-0 h-dvh max-h-none w-screen max-w-none bg-transparent p-0" aria-label={`Galería de ${event.title}`}><div class="relative flex h-full w-full items-center justify-center bg-petroleo/95 p-5 sm:p-12"><button id="gallery-close" type="button" class="absolute right-5 top-5 flex h-11 w-11 items-center justify-center rounded-full border border-white/20 text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" aria-label="Cerrar galería"><X class="h-5 w-5" /></button><p id="gallery-counter" class="absolute left-5 top-8 text-xs font-bold tracking-[0.14em] text-white/75" aria-live="polite"></p><img id="gallery-modal-image" src="" alt="" class="max-h-full max-w-full object-contain" />{gallery.length > 1 && <><button id="gallery-previous" type="button" class="absolute left-5 flex h-11 w-11 items-center justify-center rounded-full border border-white/20 text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" aria-label="Foto anterior"><ChevronLeft class="h-6 w-6" /></button><button id="gallery-next" type="button" class="absolute right-5 flex h-11 w-11 items-center justify-center rounded-full border border-white/20 text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" aria-label="Foto siguiente"><ChevronRight class="h-6 w-6" /></button></>}</div></dialog>}

  <Footer />

  <script>
    const formatCalendarDate = (date: Date) => date.toISOString().replace(/[-:]/g, "").replace(/\.\d{3}/, "");

    document.addEventListener("click", async (event) => {
      const calendarButton = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-calendar-button]");
      if (calendarButton) {
        const start = new Date(calendarButton.dataset.calendarDate ?? "");
        if (Number.isNaN(start.getTime())) return;
        const end = new Date(start.getTime() + 60 * 60 * 1000);
        const content = ["BEGIN:VCALENDAR", "VERSION:2.0", "BEGIN:VEVENT", `DTSTART:${formatCalendarDate(start)}`, `DTEND:${formatCalendarDate(end)}`, `SUMMARY:${calendarButton.dataset.calendarTitle ?? "Encuentro Nexis Oaxaca"}`, "END:VEVENT", "END:VCALENDAR"].join("\r\n");
        const url = URL.createObjectURL(new Blob([content], { type: "text/calendar" }));
        const link = document.createElement("a");
        link.href = url;
        link.download = "encuentro-nexis.ics";
        link.click();
        URL.revokeObjectURL(url);
        return;
      }

      const shareButton = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-share-button]");
      if (!shareButton) return;
      try {
        const title = shareButton.dataset.shareTitle ?? "Encuentro Nexis Oaxaca";
        const url = shareButton.dataset.shareUrl ?? window.location.href;
        if (navigator.share) await navigator.share({ title, url });
        else await navigator.clipboard?.writeText(url);
      } catch {
        // Cerrar el diálogo nativo no requiere retroalimentación adicional.
      }
    });

    const modal = document.querySelector<HTMLDialogElement>("#gallery-modal");
    const modalImage = document.querySelector<HTMLImageElement>("#gallery-modal-image");
    const counter = document.querySelector<HTMLElement>("#gallery-counter");
    const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>(".gallery-trigger"));
    let currentIndex = 0;
    const showImage = (index: number) => {
      if (!modalImage || !counter || triggers.length === 0) return;
      currentIndex = (index + triggers.length) % triggers.length;
      const trigger = triggers[currentIndex];
      modalImage.src = trigger.dataset.gallerySrc ?? "";
      modalImage.alt = trigger.dataset.galleryAlt ?? "";
      counter.textContent = `${currentIndex + 1} / ${triggers.length}`;
    };
    triggers.forEach((trigger, index) => trigger.addEventListener("click", () => { showImage(index); modal?.showModal(); }));
    document.querySelector("#gallery-close")?.addEventListener("click", () => modal?.close());
    document.querySelector("#gallery-previous")?.addEventListener("click", () => showImage(currentIndex - 1));
    document.querySelector("#gallery-next")?.addEventListener("click", () => showImage(currentIndex + 1));
    modal?.addEventListener("click", (event) => { if (event.target === modal) modal.close(); });
    modal?.addEventListener("keydown", (event) => { if (event.key === "ArrowLeft") showImage(currentIndex - 1); if (event.key === "ArrowRight") showImage(currentIndex + 1); });
  </script>
</Layout>
