---
import { ArrowUpRight, CalendarDays, MapPin, Share2 } from "lucide-astro";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import EventCard from "../../components/EventCard.astro";
import { getEvents } from "../../lib/cms";
import { richTextToText } from "../../lib/cms/rich-text";

const events = await getEvents();

const parseEventDate = (dateStr: string) => {
  const value = dateStr?.trim();
  if (!value) return null;
  const normalized = value.includes("T") ? value : value.replace(" ", "T").replace(/\//g, "-");
  const date = new Date(normalized.includes("T") ? normalized : `${normalized}T00:00:00`);
  return Number.isNaN(date.getTime()) ? null : date;
};

const now = new Date();
const chronologicalEvents = [...events].sort((a, b) => (parseEventDate(a.date)?.getTime() ?? Infinity) - (parseEventDate(b.date)?.getTime() ?? Infinity));
const isFinishedEvent = (event: typeof events[number]) => event.status?.toLocaleLowerCase().includes("finaliz") ?? false;
const upcomingEvents = chronologicalEvents.filter((event) => {
  const eventDate = parseEventDate(event.date);
  return !isFinishedEvent(event) && (eventDate?.getTime() ?? 0) >= now.getTime();
});
const previousEvents = chronologicalEvents
  .filter((event) => isFinishedEvent(event) || (parseEventDate(event.date)?.getTime() ?? 0) < now.getTime())
  .reverse();
const featuredEvent = upcomingEvents[0] ?? previousEvents[0] ?? null;
const agendaEvents = upcomingEvents.filter((event) => event.slug !== featuredEvent?.slug);
const archivedEvents = previousEvents.filter((event) => event.slug !== featuredEvent?.slug);
const displayedPreviousEvents = archivedEvents.slice(0, 6);
const additionalPreviousEvents = archivedEvents.slice(6);

const getModality = (event: typeof events[number]) => {
  const source = `${event.type ?? ""} ${event.location ?? ""}`.toLowerCase();
  if (source.includes("híbrido") || source.includes("hibrido")) return "HÍBRIDO";
  if (source.includes("virtual") || source.includes("línea") || source.includes("linea") || source.includes("remoto")) return "EN LÍNEA";
  return "PRESENCIAL";
};

const getEventStatus = (event: typeof events[number], isPast: boolean) => {
  const source = event.status?.toLocaleLowerCase() ?? "";
  if (isPast || source.includes("finalizado")) return "FINALIZADO";
  if (source.includes("cancel")) return "CANCELADO";
  if (source.includes("lleno")) return "CUPO LLENO";
  if (source.includes("registro")) return "REGISTRO ABIERTO";
  return "PRÓXIMAMENTE";
};

const featuredDate = featuredEvent ? parseEventDate(featuredEvent.date) : null;
const featuredDescription = featuredEvent ? richTextToText(featuredEvent.description) : "";
const featuredSpeaker = featuredEvent?.speakers?.[0];
const isFeaturedUpcoming = featuredEvent ? upcomingEvents.some((event) => event.slug === featuredEvent.slug) : false;
const featuredStatus = featuredEvent ? getEventStatus(featuredEvent, !isFeaturedUpcoming) : "";
---

<Layout title="Encuentros de tecnología | Nexis Oaxaca" description="Explora charlas, talleres y encuentros para aprender, conectar y descubrir tecnología desde Oaxaca.">
  <Header />

  <main class="bg-marfil pb-24 pt-28 sm:pt-32">
    <div class="mx-auto max-w-7xl px-6">
      <section aria-labelledby="events-title">
        <p class="text-xs font-bold tracking-[0.16em] text-jade">PRÓXIMOS ENCUENTROS</p>
        <div class="mt-4 max-w-3xl">
          <h1 id="events-title" class="font-display text-4xl font-extrabold tracking-tight text-petroleo sm:text-5xl">Encuentra algo nuevo por explorar.</h1>
          <p class="mt-4 max-w-2xl text-base leading-7 text-petroleo/75 sm:text-lg">Charlas, talleres y encuentros para aprender, conocer personas y acercarte a nuevas posibilidades en tecnología.</p>
        </div>

        {featuredEvent ? (
          <article class="mt-12 grid overflow-hidden rounded-card border border-petroleo/12 bg-white md:grid-cols-[minmax(18rem,0.82fr)_1.18fr]">
            <div class="relative aspect-video bg-arena md:aspect-auto">
              <img src={featuredEvent.image} alt={`Imagen del encuentro: ${featuredEvent.title}`} class="h-full w-full object-cover" />
              <span class="absolute left-5 top-5 rounded-md bg-petroleo px-3 py-1.5 text-[10px] font-bold tracking-[0.14em] text-white">{getModality(featuredEvent)}</span>
            </div>
            <div class="flex flex-col p-7 sm:p-9">
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-bold tracking-[0.12em] text-jade">
                <span>{isFeaturedUpcoming ? "PRÓXIMO EVENTO" : "ÚLTIMO ENCUENTRO"}</span>
                <span class="text-petroleo/55">{featuredStatus}</span>
              </div>
              <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-petroleo/75">
                <time datetime={featuredDate?.toISOString()} class="inline-flex items-center gap-2"><CalendarDays class="h-4 w-4 text-jade" />{featuredDate?.toLocaleDateString("es-MX", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "America/Mexico_City" }).toUpperCase()}</time>
                <span class="inline-flex items-center gap-2"><MapPin class="h-4 w-4 text-jade" />{getModality(featuredEvent)}</span>
              </div>
              <h2 class="mt-5 max-w-2xl font-display text-2xl font-bold leading-tight text-petroleo sm:text-3xl">{featuredEvent.title}</h2>
              <p class="mt-4 max-w-2xl line-clamp-2 text-sm leading-6 text-petroleo/70">{featuredDescription}</p>
              {featuredSpeaker && <div class="mt-5 border-t border-petroleo/8 pt-4"><p class="text-sm font-semibold text-petroleo">{featuredSpeaker.name}</p>{featuredSpeaker.role && <p class="mt-1 text-xs text-petroleo/60">{featuredSpeaker.role}</p>}</div>}
              <div class="mt-7 flex flex-wrap items-center gap-4">
                <a href={`/eventos/${featuredEvent.slug}`} class="inline-flex min-h-11 items-center gap-2 rounded-button bg-petroleo px-5 text-sm font-bold text-white transition-colors duration-200 hover:bg-jade focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-jade">Conoce el encuentro <ArrowUpRight class="h-4 w-4" /></a>
                {isFeaturedUpcoming && featuredEvent.registerLink && featuredStatus !== "CANCELADO" && featuredStatus !== "CUPO LLENO" && <a href={featuredEvent.registerLink} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-sm font-bold text-petroleo underline decoration-jade/50 underline-offset-4 transition-colors duration-200 hover:text-jade focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-jade">Registrarme</a>}
                <button type="button" class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-petroleo/70 transition-colors duration-200 hover:text-jade focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-jade" data-share-event data-share-title={featuredEvent.title} data-share-url={`/eventos/${featuredEvent.slug}`}><Share2 class="h-4 w-4" />Compartir</button>
              </div>
            </div>
          </article>
        ) : (
          <div class="mt-12 rounded-card border border-dashed border-petroleo/20 bg-white px-6 py-10 text-petroleo/70"><h2 class="font-display text-2xl font-bold text-petroleo">Aún no hay encuentros publicados</h2><p class="mt-2 text-sm">Vuelve pronto para conocer la próxima actividad de Nexis Oaxaca.</p></div>
        )}
      </section>

      <section class="mt-20" aria-labelledby="upcoming-events-title">
        <div class="flex flex-col gap-6 border-b border-petroleo/10 pb-7 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="text-xs font-bold tracking-[0.16em] text-jade">AGENDA</p>
            <h2 id="upcoming-events-title" class="mt-3 font-display text-3xl font-bold text-petroleo">Próximos encuentros</h2>
          </div>
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
            <div class="-mx-1 flex gap-2 overflow-x-auto px-1 pb-1" role="group" aria-label="Filtrar por modalidad">
              <button type="button" class="min-h-11 shrink-0 rounded-button bg-petroleo px-4 text-sm font-bold text-white" data-event-filter="all" aria-pressed="true">Todos</button>
              <button type="button" class="min-h-11 shrink-0 rounded-button border border-petroleo/15 px-4 text-sm font-semibold text-petroleo transition-colors duration-200 hover:border-jade" data-event-filter="EN LÍNEA" aria-pressed="false">En línea</button>
              <button type="button" class="min-h-11 shrink-0 rounded-button border border-petroleo/15 px-4 text-sm font-semibold text-petroleo transition-colors duration-200 hover:border-jade" data-event-filter="PRESENCIAL" aria-pressed="false">Presenciales</button>
            </div>
            <label class="sr-only" for="event-search">Buscar eventos</label>
            <input id="event-search" type="search" placeholder="Buscar eventos" class="h-11 w-full rounded-button border border-petroleo/15 bg-white px-4 text-sm text-petroleo outline-none placeholder:text-petroleo/45 focus:border-jade sm:w-52" data-event-search-input />
          </div>
        </div>

        {agendaEvents.length > 0 ? (
          <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3" data-events-grid>
            {agendaEvents.map((event) => <EventCard event={event} />)}
          </div>
        ) : (
          <div class="mt-8 rounded-card border border-dashed border-petroleo/20 bg-white/60 px-6 py-10"><p class="font-semibold text-petroleo">No hay más encuentros próximos por ahora.</p><p class="mt-2 text-sm text-petroleo/65">Consulta los eventos anteriores o vuelve pronto para conocer la nueva agenda.</p></div>
        )}
        <p class="mt-8 hidden rounded-card border border-dashed border-petroleo/20 bg-white/60 px-6 py-8 text-sm text-petroleo/65" data-filter-empty>No encontramos encuentros con esos criterios.</p>
      </section>

      {displayedPreviousEvents.length > 0 && (
        <section class="mt-24 border-t border-petroleo/10 pt-12" aria-labelledby="past-events-title">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <div><p class="text-xs font-bold tracking-[0.16em] text-petroleo/55">ARCHIVO</p><h2 id="past-events-title" class="mt-3 font-display text-3xl font-bold text-petroleo">Eventos anteriores</h2></div>
          </div>
          <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {displayedPreviousEvents.map((event) => <EventCard event={event} past />)}
            {additionalPreviousEvents.map((event) => <div data-additional-past><EventCard event={event} past /></div>)}
          </div>
          {additionalPreviousEvents.length > 0 && <div class="mt-8 h-px" data-past-events-sentinel aria-hidden="true"></div>}
        </section>
      )}
    </div>
  </main>

  <Footer />
</Layout>

<script>
  let activeFilter = "all";
  let pastEventsObserver: IntersectionObserver | undefined;

  const syncEvents = () => {
    const query = (document.querySelector<HTMLInputElement>("[data-event-search-input]")?.value ?? "").trim().toLocaleLowerCase();
    const cards = document.querySelectorAll<HTMLElement>("[data-events-grid] [data-event-card]");
    let visible = 0;

    cards.forEach((card) => {
      const matchesFilter = activeFilter === "all" || card.dataset.eventModality === activeFilter;
      const matchesQuery = !query || card.dataset.eventSearch?.includes(query);
      const show = matchesFilter && matchesQuery;
      card.hidden = !show;
      if (show) visible += 1;
    });

    const emptyState = document.querySelector<HTMLElement>("[data-filter-empty]");
    if (emptyState) emptyState.hidden = visible > 0;
  };

  document.addEventListener("click", async (event) => {
    const filter = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-event-filter]");
    if (filter) {
      activeFilter = filter.dataset.eventFilter ?? "all";
      document.querySelectorAll<HTMLButtonElement>("[data-event-filter]").forEach((button) => {
        const isActive = button === filter;
        button.setAttribute("aria-pressed", String(isActive));
        button.classList.toggle("bg-petroleo", isActive);
        button.classList.toggle("text-white", isActive);
        button.classList.toggle("border-petroleo", isActive);
        button.classList.toggle("border", !isActive);
        button.classList.toggle("border-petroleo/15", !isActive);
        button.classList.toggle("text-petroleo", !isActive);
      });
      syncEvents();
      return;
    }

    const shareButton = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-share-event]");
    if (!shareButton) return;
    const url = new URL(shareButton.dataset.shareUrl ?? "/eventos", window.location.origin).toString();
    const title = shareButton.dataset.shareTitle ?? "Encuentro Nexis Oaxaca";
    try {
      if (navigator.share) {
        await navigator.share({ title, url });
      } else {
        await navigator.clipboard?.writeText(url);
        shareButton.textContent = "Enlace copiado";
      }
    } catch {
      // Cancelar el diálogo nativo de compartir no requiere ninguna acción adicional.
    }

  });

  document.addEventListener("input", (event) => {
    if ((event.target as HTMLElement).matches("[data-event-search-input]")) syncEvents();
  });

  const setupInfinitePastEvents = () => {
    pastEventsObserver?.disconnect();

    const additionalCards = [...document.querySelectorAll<HTMLElement>("[data-additional-past]")];
    const sentinel = document.querySelector<HTMLElement>("[data-past-events-sentinel]");
    if (!sentinel || additionalCards.length === 0 || !window.IntersectionObserver) return;

    let nextCard = 0;
    const revealNextBatch = () => {
      additionalCards.slice(nextCard, nextCard + 6).forEach((card) => {
        card.hidden = false;
      });
      nextCard += 6;

      if (nextCard >= additionalCards.length) pastEventsObserver?.disconnect();
    };

    additionalCards.forEach((card) => {
      card.hidden = true;
    });

    pastEventsObserver = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) revealNextBatch();
    }, { rootMargin: "300px 0px" });
    pastEventsObserver.observe(sentinel);
  };

  document.addEventListener("astro:page-load", setupInfinitePastEvents);
</script>
