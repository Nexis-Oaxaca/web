---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import EventCard from "../../components/EventCard.astro";
import { getEvents } from "../../lib/cms";

const events = await getEvents();

const parseEventDate = (dateStr: string) => {
  if (!dateStr) return null;

  const value = dateStr.trim();

  if (value.includes("T")) {
    const parsed = new Date(value);
    if (!Number.isNaN(parsed.getTime())) return parsed;
  }

  if (value.includes(" ")) {
    const parsed = new Date(value.replace(" ", "T"));
    if (!Number.isNaN(parsed.getTime())) return parsed;
  }

  const normalized = value.replace(/\//g, "-");
  const fallback = new Date(`${normalized}T00:00:00`);
  return Number.isNaN(fallback.getTime()) ? null : fallback;
};

const sortedEvents = [...events].sort((left, right) => {
  const leftTime = parseEventDate(left.date)?.getTime() ?? Number.POSITIVE_INFINITY;
  const rightTime = parseEventDate(right.date)?.getTime() ?? Number.POSITIVE_INFINITY;
  return leftTime - rightTime;
});

const now = new Date().getTime();
const upcomingEvents = sortedEvents.filter((event) => {
  const eventTime = parseEventDate(event.date)?.getTime();
  return typeof eventTime === "number" && eventTime >= now;
});

const featuredEvent = upcomingEvents[0] ?? sortedEvents.at(-1) ?? null;
const remainingEvents = featuredEvent
  ? sortedEvents
      .filter((event) => event.slug !== featuredEvent.slug)
      .sort((left, right) => {
        const leftTime = parseEventDate(left.date)?.getTime() ?? Number.NEGATIVE_INFINITY;
        const rightTime = parseEventDate(right.date)?.getTime() ?? Number.NEGATIVE_INFINITY;
        return rightTime - leftTime;
      })
  : sortedEvents;
---

<Layout title="Encuentros | Nexis Oaxaca" description="La agenda de encuentros de Nexis Oaxaca. Charlas, talleres y convivencias para aprender tecnología en compañía, sin experiencia previa.">
  <Header />

  <main class="bg-marfil pt-32 pb-24">
    <div class="mx-auto max-w-7xl px-6">
      <section class="grid gap-12 lg:grid-cols-[1.02fr_.98fr] lg:items-center">
        <div class="text-left">
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-jade/20 bg-jade/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-petroleo">
            La comunidad en movimiento
          </div>
          <h1 class="mb-8 font-display text-4xl font-extrabold uppercase leading-[1.02] tracking-tight text-petroleo sm:text-5xl md:text-7xl">
            Los encuentros <span class="text-jade">que vienen</span>
          </h1>
          <p class="max-w-2xl text-base font-medium leading-relaxed text-petroleo/80 sm:text-lg md:text-xl">
            Cada encuentro es una excusa para juntarse, aprender algo y conocer gente. Sin registro formal ni experiencia: si te late, llega.
          </p>
        </div>

        <div class="relative">
          {featuredEvent ? (
            <EventCard event={featuredEvent} featured />
          ) : (
            <div class="rounded-4xl border border-petroleo/8 bg-white p-10 text-left shadow-sm">
              <p class="text-xs font-bold uppercase tracking-widest text-petroleo/50">Próximo encuentro</p>
              <h2 class="mt-3 font-display text-3xl font-bold text-petroleo">Aún no hay encuentros publicados</h2>
              <p class="mt-4 max-w-lg text-sm leading-relaxed text-petroleo/70">
                En cuanto el CMS reciba nuevas fechas, esta tarjeta destacada aparecerá aquí.
              </p>
            </div>
          )}
        </div>
      </section>

      <section class="mt-20">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4 text-left">
          <div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-petroleo/55">Agenda completa</p>
            <h2 class="mt-3 font-display text-2xl font-bold text-petroleo sm:text-3xl">Más encuentros para sumarte</h2>
          </div>
          <p class="max-w-xl text-sm leading-relaxed text-petroleo/65">
            Eventos abiertos, gratuitos y sin registro obligatorio. Elige el que más te acomode y abre el detalle para ver la información completa.
          </p>
        </div>

        {remainingEvents.length > 0 ? (
          <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3" data-events-grid>
            {remainingEvents.map((event) => (
              <EventCard event={event} detailHref={`/eventos/${event.slug}`} />
            ))}
          </div>
        ) : (
          <div class="rounded-4xl border border-dashed border-petroleo/15 bg-white/70 p-10 text-left text-petroleo/65">
            No hay más encuentros para mostrar por ahora.
          </div>
        )}
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  const STORAGE_KEY = "nexis-event-favorites";

  const safeParse = (value) => {
    try {
      const parsed = JSON.parse(value || "[]");
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  };

  const getFavorites = () => {
    try {
      return safeParse(window.localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  };

  const setFavorites = (favorites) => {
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(favorites));
    } catch {
      // LocalStorage puede no estar disponible en algunos contextos.
    }
  };

  const closeAllMenus = (exceptMenu = null) => {
    document.querySelectorAll("[data-share-menu]").forEach((menu) => {
      if (menu === exceptMenu) return;
      menu.classList.add("hidden");
      const toggle = menu.closest("[data-event-card]")?.querySelector("[data-share-toggle]");
      toggle?.setAttribute("aria-expanded", "false");
    });
  };

  const syncFavoriteButtons = () => {
    const favorites = getFavorites();

    document.querySelectorAll("[data-event-card]").forEach((card) => {
      const slug = card.dataset.eventSlug;
      const button = card.querySelector("[data-favorite-toggle]");

      if (!slug || !button) return;

      const isFavorite = favorites.includes(slug);
      button.setAttribute("aria-pressed", String(isFavorite));
      button.classList.toggle("text-rose-500", isFavorite);
      button.classList.toggle("bg-rose-50", isFavorite);
      button.classList.toggle("border-rose-200", isFavorite);
      button.classList.toggle("text-petroleo", !isFavorite);
      button.classList.toggle("bg-white/90", !isFavorite);
    });
  };

  const reorderEventsByFavorites = () => {
    const grid = document.querySelector("[data-events-grid]");
    if (!grid) return;

    const favorites = getFavorites();
    const cards = Array.from(grid.querySelectorAll("[data-event-card]")).map((card, index) => ({
      card,
      index,
      slug: card.dataset.eventSlug || "",
      isFavorite: favorites.includes(card.dataset.eventSlug || ""),
    }));

    cards
      .sort((left, right) => {
        if (left.isFavorite !== right.isFavorite) {
          return left.isFavorite ? -1 : 1;
        }

        return left.index - right.index;
      })
      .forEach(({ card }) => {
        grid.appendChild(card);
      });
  };

  const openShare = (network, card) => {
    const detailPath = card.dataset.sharePath || card.dataset.eventHref || "/";
    const url = new URL(detailPath, window.location.origin).toString();
    const title = card.dataset.shareTitle || "Encuentro Nexis Oaxaca";
    const text = `${title} - ${url}`;

    const shareTargets = {
      facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
      whatsapp: `https://wa.me/?text=${encodeURIComponent(text)}`,
      x: `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`,
      linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
      telegram: `https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`,
    };

    const target = shareTargets[network];
    if (target) {
      window.open(target, "_blank", "noopener,noreferrer");
    }
  };

  const syncShareMenuState = (card, expanded) => {
    const menu = card.querySelector("[data-share-menu]");
    const toggle = card.querySelector("[data-share-toggle]");

    if (!menu || !toggle) return;

    menu.classList.toggle("hidden", !expanded);
    toggle.setAttribute("aria-expanded", String(expanded));

    if (expanded) {
      menu.querySelector("[role='menuitem']")?.focus();
    }
  };

  document.addEventListener("DOMContentLoaded", () => {
    syncFavoriteButtons();
    reorderEventsByFavorites();

    document.querySelectorAll("[data-event-card]").forEach((card) => {
      card.addEventListener("click", (event) => {
        const interactiveTarget = event.target.closest("a,button,[role='menuitem']");
        if (interactiveTarget) return;

        const href = card.dataset.eventHref;
        if (href) window.location.href = href;
      });

      card.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        if (event.target !== card) return;

        event.preventDefault();
        const href = card.dataset.eventHref;
        if (href) window.location.href = href;
      });
    });
  });

  document.addEventListener("click", (event) => {
    const shareToggle = event.target.closest("[data-share-toggle]");
    const favoriteToggle = event.target.closest("[data-favorite-toggle]");
    const shareOption = event.target.closest("[data-share-option]");

    if (shareToggle) {
      event.preventDefault();
      event.stopPropagation();

      const card = shareToggle.closest("[data-event-card]");
      if (!card) return;

      const menu = card.querySelector("[data-share-menu]");
      const expanded = shareToggle.getAttribute("aria-expanded") === "true";

      closeAllMenus(menu);
      syncShareMenuState(card, !expanded);
      return;
    }

    if (favoriteToggle) {
      event.preventDefault();
      event.stopPropagation();

      const card = favoriteToggle.closest("[data-event-card]");
      if (!card) return;

      const slug = card.dataset.eventSlug;
      if (!slug) return;

      const favorites = getFavorites();
      const nextFavorites = favorites.includes(slug)
        ? favorites.filter((item) => item !== slug)
        : [...favorites, slug];

      setFavorites(nextFavorites);
      syncFavoriteButtons();
      reorderEventsByFavorites();
      return;
    }

    if (shareOption) {
      event.preventDefault();
      event.stopPropagation();

      const card = shareOption.closest("[data-event-card]");
      if (!card) return;

      const network = shareOption.dataset.shareOption;
      if (!network) return;

      openShare(network, card);
      closeAllMenus();
      return;
    }

    if (!event.target.closest("[data-event-card]")) {
      closeAllMenus();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      const openToggle = document.querySelector('[data-share-toggle][aria-expanded="true"]');
      closeAllMenus();
      openToggle?.focus();
      return;
    }

    const option = event.target.closest("[data-share-option]");
    if (!option || (event.key !== "ArrowDown" && event.key !== "ArrowUp")) return;

    event.preventDefault();
    const options = Array.from(option.closest("[data-share-menu]")?.querySelectorAll("[data-share-option]") || []);
    const direction = event.key === "ArrowDown" ? 1 : -1;
    const nextIndex = (options.indexOf(option) + direction + options.length) % options.length;
    options[nextIndex]?.focus();
  });
</script>
