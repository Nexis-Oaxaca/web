---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import EventSpotlight from '../components/EventSpotlight.vue';
import RecentEvents from '../components/RecentEvents.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import Testimonials from '../components/Testimonials.astro';
import PartnersMarquee from '../components/PartnersMarquee.astro';
import Collaborate from '../components/Collaborate.astro';
import AboutSection from '../components/AboutSection.astro';
import { getHomeContent } from '../lib/cms';

const { events, projects } = await getHomeContent();
---

<Layout title="Nexis Oaxaca | Una comunidad de gente curiosa por la tecnología" description="Somos un grupo de personas en Oaxaca que aprenden tecnología juntas. No necesitas ser experto, solo tener curiosidad. Encuentros, talleres y buena compañía.">
	<Header />

	<main class="opacity-0 transition-opacity duration-1000" id="main-content">
		<!-- Hero Section -->
		<Hero />

		<EventSpotlight client:visible events={events} />

    <!-- Recent Events -->
		<RecentEvents events={events} />

    <!-- Featured Projects -->
	<!-- <FeaturedProjects projects={projects} /> -->

    <!-- Testimonials -->
	<!-- <Testimonials /> -->

    <!-- About Section -->
    <AboutSection />

    <!-- Partners Marquee -->
    <PartnersMarquee />

    <!-- Collaborate -->
    <Collaborate />

    <Footer />
	</main>

	<script>
		import gsap from 'gsap';
		import { ScrollTrigger } from 'gsap/ScrollTrigger';
		gsap.registerPlugin(ScrollTrigger);

		const init = () => {
			const main = document.getElementById('main-content');
			if (main) main.classList.remove('opacity-0');

			const reveals = document.querySelectorAll('.reveal');
			gsap.set(reveals, { clearProps: "all" });
			reveals.forEach((el) => {
				gsap.from(el, {
					scrollTrigger: {
						trigger: el,
						start: "top 85%",
						toggleActions: "play none none none"
					},
					opacity: 0,
					y: 40,
					duration: 0.8,
					ease: "power3.out"
				});
			});

			gsap.to(".hero-iguana", {
				y: -20,
				duration: 2,
				repeat: -1,
				yoyo: true,
				ease: "sine.inOut"
			});
		};

		document.addEventListener('astro:page-load', () => {
			ScrollTrigger.getAll().forEach(t => t.kill());
			init();
		});
	</script>
</Layout>
