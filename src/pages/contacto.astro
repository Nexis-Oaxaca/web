---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactHero from '../components/contact/ContactHero.astro';
import ContactTypeSelector from '../components/contact/ContactTypeSelector.astro';
import DynamicContactFields from '../components/contact/DynamicContactFields.astro';
import FormErrorState from '../components/contact/FormErrorState.astro';
import FormField from '../components/contact/FormField.astro';
import FormSuccessState from '../components/contact/FormSuccessState.astro';
import SocialLinks from '../components/contact/SocialLinks.astro';
import SubmitButton from '../components/contact/SubmitButton.astro';
import TextareaField from '../components/contact/TextareaField.astro';
---

<Layout title="Contacto | Nexis Oaxaca" description="Colaboraciones, eventos, alianzas o nuevas ideas. Cuéntanos qué tienes en mente y conectemos.">
  <Header />
  <main class="min-h-screen bg-marfil px-5 pb-20 pt-28 sm:px-6 sm:pt-36 lg:pb-28">
    <div class="mx-auto grid max-w-6xl gap-14 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-20">
      <ContactHero />

      <section class="lg:border-l lg:border-petroleo/10 lg:pl-14" aria-labelledby="form-title">
        <div id="form-container" class="max-w-2xl">
          <div id="contact-form-intro">
            <h2 id="form-title" class="font-display text-2xl font-bold tracking-tight text-petroleo sm:text-3xl">Cuéntanos sobre tu idea</h2>
            <p class="mt-2 text-sm text-petroleo/65">Completarlo te tomará menos de 2 minutos.</p>
          </div>

          <form id="contact-form" class="mt-8 space-y-6" novalidate>
            <FormField id="nombre" label="Nombre" placeholder="Tu nombre" required={true} error="Ingresa tu nombre para continuar." />
            <FormField id="email" label="Correo electrónico" placeholder="nombre@correo.com" type="email" required={true} error="Ingresa un correo electrónico válido." />
            <ContactTypeSelector />
            <DynamicContactFields />
            <TextareaField id="mensaje" />

            <input class="sr-only" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="cf-turnstile" data-sitekey="0x4AAAAAAD6uLyml5OaSHsGS" id="turnstile-widget"></div>
            <SubmitButton />
            <p class="text-xs leading-relaxed text-petroleo/55">Usaremos tus datos únicamente para responder a tu mensaje. Al enviar aceptas nuestro <a href="/privacidad" class="font-medium text-petroleo underline decoration-jade/70 underline-offset-2 hover:text-jade">Aviso de Privacidad</a>.</p>
          </form>
          <FormErrorState />
          <FormSuccessState />
        </div>
        <SocialLinks />
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style is:global>
  .form-label { display: block; margin-bottom: 0.5rem; color: #234A57; font-size: 0.875rem; font-weight: 700; }
  .form-control { display: block; width: 100%; min-height: 3rem; border: 1px solid rgb(35 74 87 / 0.16); border-radius: 0.75rem; background: rgb(255 255 255 / 0.58); padding: 0.75rem 1rem; color: #234A57; font-size: 1rem; line-height: 1.5; transition: border-color 150ms ease, box-shadow 150ms ease, background-color 150ms ease; }
  .form-control::placeholder { color: rgb(35 74 87 / 0.45); }
  .form-control:hover { border-color: rgb(35 74 87 / 0.28); }
  .form-control:focus { outline: none; border-color: #2D8380; background: #fff; box-shadow: 0 0 0 3px rgb(45 131 128 / 0.18); }
  .form-control[aria-invalid="true"] { border-color: #dc2626; background: #fff7f7; }
  .form-control[aria-invalid="true"]:focus { box-shadow: 0 0 0 3px rgb(220 38 38 / 0.15); }
  .form-error { margin-top: 0.4rem; color: #b91c1c; font-size: 0.75rem; font-weight: 600; }
  .contact-chip { position: relative; display: inline-flex; min-height: 2.75rem; cursor: pointer; align-items: center; border: 1px solid rgb(35 74 87 / 0.16); border-radius: 0.625rem; background: rgb(255 255 255 / 0.5); padding: 0.5rem 0.75rem; color: rgb(35 74 87 / 0.8); font-size: 0.8125rem; font-weight: 600; transition: color 150ms ease, border-color 150ms ease, background-color 150ms ease, box-shadow 150ms ease; }
  .contact-chip input { position: absolute; opacity: 0; }
  .contact-chip:has(input:checked) { border-color: #2D8380; background: rgb(45 131 128 / 0.1); color: #234A57; }
  .contact-chip:has(input:focus-visible) { outline: none; box-shadow: 0 0 0 3px rgb(45 131 128 / 0.22); }
  .contact-chip:hover { border-color: rgb(45 131 128 / 0.65); }
</style>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  type FieldName = 'nombre' | 'email' | 'mensaje';

  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitButton = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const buttonText = document.getElementById('btn-text');
    const buttonIcon = document.getElementById('btn-icon');
    const spinner = document.getElementById('btn-spinner');
    const success = document.getElementById('success-message');
    const error = document.getElementById('form-error');
    const intro = document.getElementById('contact-form-intro');
    const dynamicFields = document.getElementById('dynamic-fields');
    if (!form || !submitButton) return;

    let started = false;
    let submitting = false;
    const analytics = (event: string) => window.dispatchEvent(new CustomEvent('nexis:analytics', { detail: { event } }));
    analytics('contact_form_view');

    const setFieldError = (name: FieldName, message?: string) => {
      const field = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
      const errorText = document.getElementById(`${name}-error`);
      field?.setAttribute('aria-invalid', 'true');
      if (errorText && message) errorText.textContent = message;
      errorText?.removeAttribute('hidden');
    };
    const clearFieldError = (name: FieldName) => {
      const field = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
      field?.removeAttribute('aria-invalid');
      document.getElementById(`${name}-error`)?.setAttribute('hidden', '');
    };
    const validateField = (name: FieldName) => {
      const field = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
      const value = field?.value.trim() || '';
      const valid = name === 'email' ? /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value) : value.length > 0;
      if (valid) clearFieldError(name); else setFieldError(name);
      return valid;
    };
    const updateDynamicFields = () => {
      const selected = form.querySelector<HTMLInputElement>('input[name="categoria"]:checked')?.value;
      dynamicFields?.querySelectorAll<HTMLElement>('[data-contact-field]').forEach((field) => {
        field.hidden = field.dataset.contactField !== selected;
      });
    };
    const beginForm = () => {
      if (!started) { started = true; analytics('contact_form_started'); }
    };

    form.querySelectorAll<HTMLInputElement>('input[name="categoria"]').forEach((input) => input.addEventListener('change', () => {
      updateDynamicFields(); beginForm(); analytics('contact_type_selected');
    }));
    (['nombre', 'email', 'mensaje'] as FieldName[]).forEach((name) => {
      const input = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
      input?.addEventListener('input', () => { beginForm(); if (input.getAttribute('aria-invalid') === 'true') validateField(name); });
      input?.addEventListener('blur', () => { if (input.value) validateField(name); });
    });
    updateDynamicFields();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return;
      error?.setAttribute('hidden', '');
      const valid = (['nombre', 'email', 'mensaje'] as FieldName[]).every(validateField);
      const category = form.querySelector<HTMLInputElement>('input[name="categoria"]:checked');
      if (!category) { document.getElementById('categoria-error')?.removeAttribute('hidden'); return; }
      document.getElementById('categoria-error')?.setAttribute('hidden', '');
      if (!valid) return;

      const data = new FormData(form);
      const token = document.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')?.value || '';
      if (!token) { error?.removeAttribute('hidden'); return; }
      submitting = true;
      submitButton.disabled = true;
      if (buttonText) buttonText.textContent = 'Enviando...';
      buttonIcon?.classList.add('hidden'); spinner?.classList.remove('hidden');
      analytics('contact_form_submitted');
      try {
        const response = await fetch('/api/contacto', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
          nombre: data.get('nombre'), email: data.get('email'), categoria: data.get('categoria'), mensaje: data.get('mensaje'),
          institucion: data.get('institucion'), organizacion: data.get('organizacion'), tema: data.get('tema'), website: data.get('website'), 'cf-turnstile-response': token,
        }) });
        if (!response.ok) throw new Error('Contact request failed');
        form.hidden = true; intro?.setAttribute('hidden', ''); success?.classList.remove('hidden'); analytics('contact_form_success');
      } catch {
        error?.removeAttribute('hidden'); analytics('contact_form_error');
        submitButton.disabled = false;
        if (buttonText) buttonText.textContent = 'Enviar mensaje';
        buttonIcon?.classList.remove('hidden'); spinner?.classList.add('hidden');
      } finally { submitting = false; }
    });
  }
  document.addEventListener('astro:page-load', initContactForm);
</script>
