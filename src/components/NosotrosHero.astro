---
import { ArrowRight, Calendar } from 'lucide-astro';

interface Props {
  eventsCount: number;
}

const { eventsCount } = Astro.props as Props;
---

<section class="min-h-[90vh] relative flex items-center pt-28 overflow-hidden bg-marfil">
  <div class="mitla-pattern absolute inset-0 -z-10 opacity-30"></div>
  <div class="max-w-7xl mx-auto px-6 relative z-10 grid lg:grid-cols-2 gap-16 items-center">
    <div class="space-y-8 reveal">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-jade/10 border border-jade/20 text-jade text-xs font-bold uppercase tracking-widest">
        <span class="w-2 h-2 rounded-full bg-jade animate-pulse"></span>
        <span class="text-petroleo">Quiénes somos</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-4xl xl:text-6xl font-extrabold text-petroleo leading-[1.05] tracking-tight font-display uppercase">
        Encuentra tu forma de <span class="text-jade">participar.</span>
      </h1>
      <p class="text-sm sm:text-base md:text-xl text-petroleo/85 max-w-xl leading-relaxed">
        Nexis Oaxaca es una iniciativa juvenil que crea espacios y experiencias para aprender, conectar y descubrir oportunidades en tecnología.
      </p>
      <p class="text-sm sm:text-base text-petroleo/70 max-w-xl leading-relaxed">
        Puedes empezar por un encuentro, volver para seguir aprendiendo y, cuando quieras, compartir o ayudar a crear lo que sigue.
      </p>
      <div class="flex flex-wrap gap-4 pt-2">
        <a href="/eventos">
          <button class="bg-jade text-white px-8 py-4 rounded-[18px] font-bold text-sm sm:text-base hover:scale-105 transition-all shadow-xl shadow-jade/20 flex items-center group cursor-pointer">
            Ver próximos encuentros <ArrowRight class="ml-2 group-hover:translate-x-1 transition-transform" />
          </button>
        </a>
        <a href="/eventos" class="border-2 border-petroleo/10 text-petroleo px-8 py-4 rounded-[18px] font-bold text-sm sm:text-base hover:bg-petroleo/5 transition-all flex items-center group">
          Conoce qué hacemos <ArrowRight class="ml-2 w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>
    </div>
    <div class="relative hidden lg:block reveal">
      <div class="aspect-square rounded-[40px] overflow-hidden shadow-2xl border-8 border-white">
        <img
          src="https://assets.nexisoaxaca.tech/nexis_green_hero_about.png"
          alt="Personas participando en una actividad de Nexis Oaxaca"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="absolute -top-4 -right-4 bg-white rounded-[24px] shadow-xl p-5 border border-petroleo/5">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-ambar/15 flex items-center justify-center text-ambar">
            <Calendar class="w-6 h-6" />
          </div>
          <div>
            <span class="block text-2xl font-bold text-petroleo font-display">{eventsCount}+</span>
            <span class="text-xs text-petroleo/50 font-bold uppercase tracking-widest">Encuentros vividos</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
