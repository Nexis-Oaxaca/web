---
import type { EventItem } from "../lib/cms";
import { richTextToText } from "../lib/cms/rich-text";
import {
  ArrowRight,
  Calendar,
  Facebook,
  Heart,
  Instagram,
  MapPin,
  MessageCircle,
  Share2,
  Twitter,
} from "lucide-astro";

interface Props {
  event: EventItem;
  featured?: boolean;
  detailHref?: string;
}

const { event, featured = false, detailHref = `/eventos/${event.slug}` } = Astro.props as Props;

const parseEventDate = (dateStr: string) => {
  if (!dateStr) return null;
  const value = dateStr.trim();

  if (value.includes("T")) {
    const parsed = new Date(value);
    if (!Number.isNaN(parsed.getTime())) return parsed;
  }

  if (value.includes(" ")) {
    const parsed = new Date(value.replace(" ", "T"));
    if (!Number.isNaN(parsed.getTime())) return parsed;
  }

  const normalized = value.replace(/\//g, "-");
  const fallback = new Date(`${normalized}T00:00:00`);
  return Number.isNaN(fallback.getTime()) ? null : fallback;
};

const eventDate = parseEventDate(event.date);
const dayLabel = eventDate
  ? eventDate.toLocaleDateString("es-MX", {
      day: "numeric",
      timeZone: "America/Mexico_City",
    })
  : "--";

const monthLabel = eventDate
  ? eventDate.toLocaleDateString("es-MX", {
      month: "long",
      timeZone: "America/Mexico_City",
    })
  : "fecha por confirmar";

const locationLabel = event.location || "Oaxaca";
const modalityLabel = event.type?.trim() || "Evento";
const descriptionText = richTextToText(event.description);
---

<article
  class:list={[
    "js-event-card group relative isolate overflow-visible rounded-4xl border border-petroleo/8 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl",
    featured ? "flex h-full flex-col" : "flex h-full flex-col",
  ]}
  data-event-card
  data-event-slug={event.slug}
  data-event-href={detailHref}
  data-share-path={detailHref}
  role="link"
  tabindex="0"
  aria-label={`Abrir detalle de ${event.title}`}
>
  {
    featured ? (
      <div class="relative flex min-h-96 flex-col overflow-visible bg-linear-to-br p-8 text-left sm:p-10 lg:p-12">
        <div class="absolute right-0 top-0 h-40 w-40 rounded-full bg-jade/10 blur-3xl"></div>
        <div class="absolute bottom-0 left-0 h-32 w-32 rounded-full bg-ambar/10 blur-3xl"></div>

        <div class="absolute right-4 top-4 z-50 flex items-start gap-2 sm:right-6 sm:top-6 lg:right-8 lg:top-8">
          <button
            type="button"
            class="js-favorite-toggle inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/40 bg-white/95 text-petroleo shadow-lg backdrop-blur transition-all duration-200 hover:bg-white hover:text-rose-500"
            data-favorite-toggle
            aria-pressed="false"
            aria-label={`Guardar ${event.title} en favoritos`}
          >
            <Heart class="h-4 w-4" />
          </button>

          <div class="relative">
            <button
              type="button"
              class="js-share-toggle inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/40 bg-white/95 text-petroleo shadow-lg backdrop-blur transition-all duration-200 hover:bg-white hover:text-jade"
              data-share-toggle
              aria-expanded="false"
              aria-controls={`share-menu-${event.slug}`}
              aria-label={`Compartir ${event.title}`}
            >
              <Share2 class="h-4 w-4" />
            </button>

            <div
              id={`share-menu-${event.slug}`}
              class="js-share-menu absolute right-0 top-full z-9999 mt-3 hidden min-w-60 rounded-[1.5rem] border border-petroleo/10 bg-white p-2 shadow-2xl"
              data-share-menu
            >
              <p class="px-3 pb-2 pt-1 text-[10px] font-bold uppercase tracking-widest text-petroleo/45">
                Compartir este encuentro
              </p>
              <button type="button" class="js-share-option flex w-full items-center gap-3 rounded-2xl px-3 py-2.5 text-left text-sm font-semibold text-petroleo transition-colors hover:bg-jade/10" data-share-option="facebook">
                <Facebook class="h-4 w-4 text-[#1877F2]" /> Facebook
              </button>
              <button type="button" class="js-share-option flex w-full items-center gap-3 rounded-2xl px-3 py-2.5 text-left text-sm font-semibold text-petroleo transition-colors hover:bg-jade/10" data-share-option="whatsapp">
                <MessageCircle class="h-4 w-4 text-[#25D366]" /> WhatsApp
              </button>
              <button type="button" class="js-share-option flex w-full items-center gap-3 rounded-2xl px-3 py-2.5 text-left text-sm font-semibold text-petroleo transition-colors hover:bg-jade/10" data-share-option="instagram">
                <Instagram class="h-4 w-4 text-[#E4405F]" /> Instagram
              </button>
              <button type="button" class="js-share-option flex w-full items-center gap-3 rounded-2xl px-3 py-2.5 text-left text-sm font-semibold text-petroleo transition-colors hover:bg-jade/10" data-share-option="x">
                <Twitter class="h-4 w-4 text-petroleo" /> X
              </button>
            </div>
          </div>
        </div>

        <div class="relative z-10 mt-12 space-y-6 pr-16 sm:pr-20 lg:pr-24">
          <div class="flex items-end gap-3 text-petroleo">
            <span class="rounded-full border border-jade/20 bg-jade px-4 py-1.5 text-[10px] font-extrabold uppercase tracking-widest text-white shadow-lg">
              {modalityLabel}
            </span>
            <span class="rounded-full border border-petroleo/10 bg-white px-4 py-1.5 text-[10px] font-bold uppercase tracking-widest text-petroleo/60 shadow-sm">
              Evento destacado
            </span>
          </div>
          <div class="flex items-end gap-3 text-petroleo">
            <span class:list={["font-display font-bold leading-none text-jade", featured ? "text-4xl sm:text-5xl" : "text-2xl"]}>
              {dayLabel}
            </span>
            <span class="pb-1 text-[10px] font-bold uppercase tracking-[0.32em] text-petroleo/60">
              {monthLabel}
            </span>
          </div>

          <div class="flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-petroleo/75">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-petroleo/8 bg-white px-3 py-1.5 shadow-sm">
              <MapPin class="h-3.5 w-3.5 text-jade" />
              {locationLabel}
            </span>
          </div>

          <h3 class="max-w-3xl font-display text-3xl font-bold leading-[1.04] text-petroleo transition-colors group-hover:text-jade sm:text-4xl lg:text-5xl">
            {event.title}
          </h3>

          <p class="max-w-3xl text-sm leading-relaxed text-petroleo/75 line-clamp-3 md:line-clamp-5">
            {descriptionText}
          </p>

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href={detailHref}
              class="inline-flex items-center gap-2 rounded-full bg-petroleo px-5 py-3 text-xs font-bold uppercase tracking-widest text-white transition-colors hover:bg-jade"
              data-detail-link
            >
              Ver detalles
              <ArrowRight class="h-4 w-4" />
            </a>
          </div>
        </div>
      </div>
    ) : (
      <>
        <div class="relative h-64 overflow-visible">
          <div class="absolute inset-0 overflow-hidden rounded-t-4xl">
            <img
              src={event.image}
              alt={event.title}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
            />

            <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/20 to-transparent"></div>

            <div class="absolute left-5 top-5 flex items-center gap-2">
              <span class="rounded-full border border-white/20 bg-jade px-4 py-1.5 text-[10px] font-extrabold uppercase tracking-widest text-white shadow-lg">
                {modalityLabel}
              </span>
            </div>
          </div>

          <div class="absolute right-4 top-4 z-9999 flex items-start gap-2">
            <button
              type="button"
              class="js-favorite-toggle inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/90 text-petroleo shadow-lg backdrop-blur transition-all duration-200 hover:bg-white hover:text-rose-500"
              data-favorite-toggle
              aria-pressed="false"
              aria-label={`Guardar ${event.title} en favoritos`}
            >
              <Heart class="h-4 w-4" />
            </button>

            <div class="relative">
              <button
                type="button"
                class="js-share-toggle inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/90 text-petroleo shadow-lg backdrop-blur transition-all duration-200 hover:bg-white hover:text-jade"
                data-share-toggle
                aria-expanded="false"
                aria-controls={`share-menu-${event.slug}`}
                aria-label={`Compartir ${event.title}`}
              >
                <Share2 class="h-4 w-4" />
              </button>

              <div
                id={`share-menu-${event.slug}`}
                class="js-share-menu absolute right-0 top-full z-9999 mt-3 hidden min-w-60 rounded-[1.5rem] border border-petroleo/10 bg-white p-2 shadow-2xl"
                data-share-menu
              >
                <p class="px-3 pb-2 pt-1 text-[10px] font-bold uppercase tracking-widest text-petroleo/45">
                  Compartir este encuentro
                </p>
                <button type="button" class="js-share-option flex w-full items-center gap-3 rounded-2xl px-3 py-2.5 text-left text-sm font-semibold text-petroleo transition-colors hover:bg-jade/10" data-share-option="facebook">
                  <Facebook class="h-4 w-4 text-[#1877F2]" /> Facebook
                </button>
                <button type="button" class="js-share-option flex w-full items-center gap-3 rounded-2xl px-3 py-2.5 text-left text-sm font-semibold text-petroleo transition-colors hover:bg-jade/10" data-share-option="whatsapp">
                  <MessageCircle class="h-4 w-4 text-[#25D366]" /> WhatsApp
                </button>
                <button type="button" class="js-share-option flex w-full items-center gap-3 rounded-2xl px-3 py-2.5 text-left text-sm font-semibold text-petroleo transition-colors hover:bg-jade/10" data-share-option="instagram">
                  <Instagram class="h-4 w-4 text-[#E4405F]" /> Instagram
                </button>
                <button type="button" class="js-share-option flex w-full items-center gap-3 rounded-2xl px-3 py-2.5 text-left text-sm font-semibold text-petroleo transition-colors hover:bg-jade/10" data-share-option="x">
                  <Twitter class="h-4 w-4 text-petroleo" /> X
                </button>
              </div>
            </div>
          </div>

          <div class="absolute bottom-5 left-5 z-10 text-left text-white">
            <div class="flex items-end gap-3">
              <span class:list={["font-display font-bold leading-none", featured ? "text-4xl sm:text-5xl" : "text-2xl"]}>
                {dayLabel}
              </span>
              <span class="pb-1 text-[10px] font-bold uppercase tracking-[0.32em] text-white/85">
                {monthLabel}
              </span>
            </div>
            <div class="mt-3 flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-white/80">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 backdrop-blur">
                <MapPin class="h-3.5 w-3.5 text-jade" />
                {locationLabel}
              </span>
            </div>
          </div>
        </div>

        <div class="flex flex-1 flex-col p-8 text-left">
          <div class="mb-4 flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-[0.28em] text-petroleo/55">
            <span>{locationLabel}</span>
            <span class="h-1 w-1 rounded-full bg-petroleo/25"></span>
            <span>{modalityLabel}</span>
          </div>

          <h3 class:list={["font-display font-bold text-petroleo leading-[1.05] transition-colors group-hover:text-jade", featured ? "text-3xl sm:text-4xl" : "text-2xl"]}>
            {event.title}
          </h3>

          <p class:list={["mt-4 text-sm leading-relaxed text-petroleo/75", featured ? "max-w-xl" : "line-clamp-3"]}>
            {descriptionText}
          </p>

          <div class="mt-8 flex flex-wrap items-center justify-end gap-4 border-t border-petroleo/8 pt-6">
            <a
              href={detailHref}
              class="inline-flex items-center gap-2 rounded-full bg-petroleo px-5 py-3 text-xs font-bold uppercase tracking-widest text-white transition-colors hover:bg-jade"
              data-detail-link
            >
              Ver detalles
              <ArrowRight class="h-4 w-4" />
            </a>
          </div>
        </div>
      </>
    )
  }
</article>