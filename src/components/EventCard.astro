---
import { ArrowUpRight, CalendarDays, MapPin } from "lucide-astro";
import type { EventItem } from "../lib/cms";
import { richTextToText } from "../lib/cms/rich-text";

interface Props {
  event: EventItem;
  detailHref?: string;
  past?: boolean;
}

const { event, detailHref = `/eventos/${event.slug}`, past = false } = Astro.props as Props;

const parseEventDate = (dateStr: string) => {
  const value = dateStr?.trim();
  if (!value) return null;
  const normalized = value.includes("T") ? value : value.replace(" ", "T").replace(/\//g, "-");
  const date = new Date(normalized.includes("T") ? normalized : `${normalized}T00:00:00`);
  return Number.isNaN(date.getTime()) ? null : date;
};

const eventDate = parseEventDate(event.date);
const modalitySource = `${event.type ?? ""} ${event.location ?? ""}`.toLowerCase();
const modality = modalitySource.includes("híbrido") || modalitySource.includes("hibrido")
  ? "HÍBRIDO"
  : modalitySource.includes("virtual") || modalitySource.includes("línea") || modalitySource.includes("linea") || modalitySource.includes("remoto")
    ? "EN LÍNEA"
    : "PRESENCIAL";
const statusSource = event.status?.toLocaleLowerCase() ?? "";
const eventStatus = past || statusSource.includes("finalizado")
  ? "FINALIZADO"
  : statusSource.includes("cancel")
    ? "CANCELADO"
    : statusSource.includes("lleno")
      ? "CUPO LLENO"
      : statusSource.includes("registro")
        ? "REGISTRO ABIERTO"
        : "PRÓXIMAMENTE";
const description = richTextToText(event.description);
const speaker = event.speakers?.[0];
const dateLabel = eventDate?.toLocaleDateString("es-MX", {
  day: "2-digit",
  month: "short",
  timeZone: "America/Mexico_City",
}).replace(".", "").toUpperCase() ?? "FECHA POR CONFIRMAR";
---

<article
  class:list={[
    "group flex h-full flex-col overflow-hidden rounded-card border bg-white transition-colors duration-200 hover:border-jade/40 focus-within:border-jade",
    past ? "border-petroleo/8 bg-white/65" : "border-petroleo/12",
  ]}
  data-event-card
  data-event-modality={modality}
  data-event-search={`${event.title} ${description} ${speaker?.name ?? ""}`.toLocaleLowerCase()}
>
  <div class="relative aspect-video overflow-hidden bg-arena">
    <img
      src={event.image}
      alt={`Imagen del encuentro: ${event.title}`}
      class="h-full w-full object-cover transition-transform duration-200 ease-out group-hover:scale-[1.02]"
      loading="lazy"
    />
    <div class="absolute left-4 top-4 flex items-center gap-2">
      <span class="rounded-md bg-petroleo px-2.5 py-1 text-[10px] font-bold tracking-[0.12em] text-white">{modality}</span>
      <span class="rounded-md border border-white/30 bg-white/90 px-2.5 py-1 text-[10px] font-bold tracking-[0.12em] text-petroleo">{eventStatus}</span>
    </div>
  </div>

  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center justify-between gap-3 text-xs font-semibold text-petroleo/65">
      <time datetime={eventDate?.toISOString()} class="inline-flex items-center gap-2"><CalendarDays class="h-4 w-4 text-jade" />{dateLabel}</time>
      {event.location && <span class="max-w-36 truncate text-right">{event.location}</span>}
    </div>

    <h3 class="mt-5 line-clamp-2 font-display text-xl font-bold leading-tight text-petroleo group-hover:text-jade">
      {event.title}
    </h3>
    <p class="mt-3 line-clamp-2 text-sm leading-6 text-petroleo/70">{description}</p>

    <div class="mt-5 min-h-10 border-t border-petroleo/8 pt-4">
      {speaker ? (
        <div class="flex items-center gap-3">
          {speaker.image && <img src={speaker.image} alt="" class="h-8 w-8 rounded-full object-cover" loading="lazy" />}
          <div class="min-w-0">
            <p class="truncate text-sm font-semibold text-petroleo">{speaker.name}</p>
            {speaker.role && <p class="truncate text-xs text-petroleo/60">{speaker.role}</p>}
          </div>
        </div>
      ) : (
        <p class="inline-flex items-center gap-2 text-xs text-petroleo/60"><MapPin class="h-4 w-4 text-jade" />{event.location || "Oaxaca"}</p>
      )}
    </div>

    <a href={detailHref} class="mt-6 inline-flex min-h-11 items-center gap-2 self-start text-sm font-bold text-petroleo underline decoration-jade/50 underline-offset-4 transition-colors duration-200 hover:text-jade focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-jade">
      Conoce el encuentro <ArrowUpRight class="h-4 w-4" />
    </a>
  </div>
</article>
