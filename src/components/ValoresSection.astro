---
import { Sparkles } from 'lucide-astro';

interface Valor {
  icon: typeof Sparkles;
  title: string;
  description: string;
  color: string;
}

interface Props {
  valores: Valor[];
}

const { valores } = Astro.props as Props;
---

<section class="py-32 px-6 bg-petroleo relative overflow-hidden">
  <div class="mitla-pattern absolute inset-0 opacity-[0.03]"></div>
  <div class="max-w-7xl mx-auto relative z-10">
    <div class="text-center mb-20 reveal">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-white/80 text-xs font-bold uppercase tracking-widest mb-6">
        <Sparkles class="w-3 h-3" />
        <span>Las cosas en las que creemos</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white font-display leading-tight">
        Así convivimos.
      </h2>
      <p class="text-white/60 mt-4 max-w-xl mx-auto">
        No son reglas de una empresa: son formas de tratarnos que funcionan y que queremos cuidar.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal">
      {valores.map((v, i) => (
        <div
          class="group bg-white/5 backdrop-blur-sm rounded-[32px] p-8 border border-white/10 hover:bg-white/10 transition-all duration-500 hover:shadow-2xl hover:-translate-y-1 cursor-default"
          style={`transition-delay: ${i * 80}ms`}
        >
          <div class={`w-14 h-14 rounded-2xl flex items-center justify-center mb-6 transition-transform duration-300 group-hover:scale-110 ${
            v.color === 'jade' ? 'bg-jade/20 text-jade' :
            v.color === 'ambar' ? 'bg-ambar/20 text-ambar' :
            'bg-coral/20 text-coral'
          }`}>
            <v.icon class="w-7 h-7" />
          </div>
          <h3 class="text-xl font-bold text-white mb-3 font-display">{v.title}</h3>
          <p class="text-white/60 text-sm leading-relaxed">{v.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
