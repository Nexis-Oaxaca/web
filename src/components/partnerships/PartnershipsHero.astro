---
import type { PartnerItem, PartnerType } from '../../lib/cms';
import EcosystemStats from './EcosystemStats.astro';
interface Props { partners: PartnerItem[]; }
const { partners } = Astro.props;
const types: Array<[PartnerType, string]> = [['community', 'comunidades'], ['event', 'eventos'], ['educational_institution', 'instituciones'], ['company', 'empresas']];
const stats = types.map(([type, label]) => ({ label, count: partners.filter((partner) => partner.type === type).length })).filter((stat) => stat.count > 0);
---

<section class="border-b border-petroleo/10 pb-8 pt-8 sm:pb-10 sm:pt-10">
  <div class="max-w-3xl">
    <p class="text-xs font-bold tracking-[0.16em] text-jade">NUESTRO ECOSISTEMA</p>
    <h1 class="mt-4 max-w-2xl font-display text-4xl font-bold leading-[1.02] tracking-tight text-petroleo sm:text-5xl lg:text-6xl">Conectamos comunidades,<br class="hidden sm:block" /> ideas y oportunidades.</h1>
    <p class="mt-6 max-w-2xl text-base leading-7 text-petroleo/70 sm:text-lg">Colaboramos con comunidades, eventos, instituciones educativas y empresas que comparten la intención de fortalecer el ecosistema tecnológico de Oaxaca.</p>
    <EcosystemStats stats={stats} />
  </div>
</section>
