---
interface Props {
  name: string;
  logo?: string;
}

const { name, logo } = Astro.props;
const initials = name.split(/\s+/).filter(Boolean).slice(0, 2).map((word) => word[0]).join('').toUpperCase();
---

<div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border border-petroleo/10 bg-arena p-2 sm:h-16 sm:w-16" aria-hidden={logo ? undefined : 'true'}>
  {logo ? (
    <img src={logo} alt={`Logo de ${name}`} class="h-full w-full object-contain" loading="lazy" />
  ) : (
    <span class="font-display text-lg font-bold tracking-tight text-jade">{initials || '?'}</span>
  )}
</div>
