---
import { Users, Linkedin, Twitter, Github, Globe as GlobeIcon, Instagram } from 'lucide-astro';
import type { TeamMember } from '../lib/cms';

interface Props {
  team: TeamMember[];
}

const { team } = Astro.props as Props;
---

<section class="py-32 px-6 bg-marfil">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-20 reveal">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-jade/10 border border-jade/20 text-jade text-xs font-bold uppercase tracking-widest mb-6">
        <Users class="w-3 h-3" />
        <span>Quienes mueven esto</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-petroleo font-display leading-tight">
        Gente que le <span class="text-jade">echa ganas.</span>
      </h2>
      <p class="text-petroleo/70 mt-4 max-w-xl mx-auto">
        No somos una junta directiva: somos personas que organizan cosas porque les gusta. Y cualquiera puede sumarse.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 reveal">
      {team.map((member, i) => (
        <div
          class="group relative bg-white rounded-[32px] overflow-hidden border border-petroleo/5 shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-2"
          style={`transition-delay: ${i * 100}ms`}
        >
          <div class={`absolute top-0 left-0 w-full h-2 ${member.color}`}></div>
          <div class="p-8 pt-10">
            <div class="relative w-28 h-28 mx-auto mb-6">
              <div class={`absolute inset-0 ${member.color} rounded-[24px] rotate-6 group-hover:rotate-12 transition-transform duration-500`}></div>
              <img
                src={member.image}
                alt={member.name}
                class="relative z-10 w-full h-full object-cover rounded-[24px] border-4 border-white shadow-lg grayscale group-hover:grayscale-0 transition-all duration-500"
              />
            </div>
            <div class="text-center">
              <h3 class="text-lg font-bold text-petroleo font-display">{member.name}</h3>
              <p class="text-[10px] text-jade font-bold uppercase tracking-widest mb-3">{member.role}</p>
              {member.description && <p class="text-xs text-petroleo/65 leading-relaxed mb-5 line-clamp-3">{member.description}</p>}
              <div class="flex justify-center space-x-4 text-petroleo/40">
                {Object.entries(member.social).map(([key, url]) => (
                  <a href={url} target="_blank" aria-label={`${member.name} en ${key}`} class="hover:text-jade transition-colors social-icon-link">
                    {key === 'linkedin' && <Linkedin class="w-4 h-4" />}
                    {key === 'twitter' && <Twitter class="w-4 h-4" />}
                    {key === 'github' && <Github class="w-4 h-4" />}
                    {key === 'globe' && <GlobeIcon class="w-4 h-4" />}
                    {key === 'instagram' && <Instagram class="w-4 h-4" />}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
