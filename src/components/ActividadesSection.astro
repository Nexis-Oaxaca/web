---
import { Zap } from 'lucide-astro';

interface Actividad {
  icon: typeof Zap;
  title: string;
  description: string;
  stat?: string;
}

interface Props {
  actividades: Actividad[];
}

const { actividades } = Astro.props as Props;
---

<section class="py-32 px-6 bg-arena relative overflow-hidden">
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-jade/5 rounded-full blur-3xl"></div>
  <div class="max-w-7xl mx-auto relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 items-center reveal">
      <div>
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-jade/10 border border-jade/20 text-jade text-xs font-bold uppercase tracking-widest mb-6">
          <Zap class="w-3 h-3" />
          <span>Qué hacemos</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-petroleo font-display leading-tight mb-8">
          Creamos <span class="text-jade">experiencias</span> que transforman.
        </h2>
        <p class="text-petroleo/75 leading-relaxed mb-10">
          Cada actividad que organizamos está diseñada para generar aprendizaje real, conexiones auténticas y oportunidades concretas para nuestra comunidad.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {actividades.map((a, i) => (
          <div
            class="bg-white rounded-[24px] p-6 border border-petroleo/5 shadow-sm hover:shadow-lg transition-all duration-500 hover:-translate-y-1 group"
            style={`transition-delay: ${i * 80}ms`}
          >
            <div class="flex items-start justify-between mb-4">
              <div class="w-10 h-10 rounded-xl bg-jade/10 flex items-center justify-center text-jade group-hover:scale-110 transition-transform duration-300">
                <a.icon class="w-5 h-5" />
              </div>
              {a.stat && <span class="text-2xl font-bold text-jade/30 font-display">{a.stat}</span>}
            </div>
            <h3 class="text-base font-bold text-petroleo mb-2">{a.title}</h3>
            <p class="text-xs text-petroleo/65 leading-relaxed">{a.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
