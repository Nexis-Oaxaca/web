<div id="dynamic-fields" aria-live="polite">
  <div data-contact-field="escuela" hidden>
    <label for="institucion" class="form-label">Institución <span class="normal-case font-normal text-petroleo/50">(opcional)</span></label>
    <input id="institucion" name="institucion" type="text" placeholder="Nombre de la institución" class="form-control" />
  </div>
  <div data-contact-field="organizacion" hidden>
    <label for="organizacion" class="form-label">Organización <span class="normal-case font-normal text-petroleo/50">(opcional)</span></label>
    <input id="organizacion" name="organizacion" type="text" placeholder="Nombre de la organización" class="form-control" />
  </div>
  <div data-contact-field="speaker" hidden>
    <label for="tema" class="form-label">Tema o área <span class="normal-case font-normal text-petroleo/50">(opcional)</span></label>
    <input id="tema" name="tema" type="text" placeholder="Cloud, IA, software..." class="form-control" />
  </div>
</div>
