---
import { CheckCircle2 } from 'lucide-astro';
---

<section id="success-message" class="hidden py-8 text-center" aria-live="polite">
  <CheckCircle2 class="mx-auto h-12 w-12 text-jade" aria-hidden="true" />
  <h2 class="mt-5 font-display text-2xl font-bold text-petroleo">Mensaje recibido</h2>
  <p class="mx-auto mt-3 max-w-sm text-sm leading-relaxed text-petroleo/65">Gracias por escribirnos. El equipo de Nexis revisará tu mensaje y te responderá al correo que proporcionaste.</p>
  <a href="/" class="mt-7 inline-flex h-12 items-center justify-center rounded-xl bg-petroleo px-6 text-sm font-bold text-white transition-colors hover:bg-petroleo/90 focus:outline-none focus:ring-4 focus:ring-jade/25">Volver al inicio</a>
</section>
