---
interface Props {
  id: string;
  label: string;
  placeholder: string;
  type?: string;
  required?: boolean;
  error: string;
}
const { id, label, placeholder, type = 'text', required = false, error } = Astro.props;
---

<div>
  <label for={id} class="form-label">{label}{required && <span aria-hidden="true"> *</span>}</label>
  <input id={id} name={id} type={type} required={required} placeholder={placeholder} aria-describedby={`${id}-error`} class="form-control" />
  <p id={`${id}-error`} class="form-error" hidden>{error}</p>
</div>
