---
// Reemplaza estas voces con testimonios reales de la comunidad.
// Nada de frases infladas: solo qué sintió cada persona al llegar.
const testimonials = [
  {
    name: "Ana",
    role: "Empezó sin saber nada",
    image: "https://i.pravatar.cc/150?u=ana",
    content: "Llegué con miedo de no saber nada y salí sintiendo que era el lugar correcto. La gente se acerca, te explica y te hace sentir en casa."
  },
  {
    name: "Carlos",
    role: "Estudiante",
    image: "https://i.pravatar.cc/150?u=carlos",
    content: "Lo que más valoro es que aquí no juzgan por tu nivel. Todos recuerdan cómo empezaron y eso se nota en cómo te reciben."
  },
  {
    name: "María",
    role: "Aprende en ratos libres",
    image: "https://i.pravatar.cc/150?u=maria",
    content: "Pensé que para acercarme necesitaba saber programar. Me equivoqué: aquí basta con tener curiosidad y ganas de conocer gente."
  }
];
---

<section class="py-32 px-6 bg-marfil">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-20 reveal">
       <h2 class="text-3xl sm:text-4xl font-bold text-petroleo font-display">Lo que dicen quienes llegaron</h2>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {testimonials.map((t, index) => (
        <div class="reveal bg-white p-10 rounded-[32px] shadow-sm border border-petroleo/5 hover:shadow-xl transition-all duration-500" style={`transition-delay: ${index * 100}ms`}>
          <div class="flex items-center space-x-4 mb-8">
            <img class="w-14 h-14 rounded-full ring-4 ring-arena" src={t.image} alt={t.name} />
            <div>
              <div class="font-bold text-petroleo">{t.name}</div>
              <div class="text-[10px] text-jade font-bold uppercase tracking-widest">{t.role}</div>
            </div>
          </div>
           <p class="text-petroleo/85 italic leading-relaxed relative">
            <span class="text-jade text-4xl absolute -top-4 -left-4 opacity-20">"</span>
            {t.content}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
