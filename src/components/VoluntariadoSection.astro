---
import { HeartHandshake, CheckCircle2, ArrowUpRight } from 'lucide-astro';

interface Props {
  volunteerReasons: string[];
}

const { volunteerReasons } = Astro.props as Props;
---

<section class="py-32 px-6 bg-arena relative overflow-hidden">
  <div class="absolute top-0 left-0 w-full h-px circuit-line"></div>
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-jade/5 rounded-full blur-3xl"></div>
  <div class="max-w-7xl mx-auto relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 items-center reveal">
      <div class="relative">
        <div class="aspect-[4/3] rounded-[40px] overflow-hidden shadow-xl">
          <img
            src="https://assets.nexisoaxaca.tech/2/f3_f99e00e2a9.jpg"
            alt="Voluntariado Nexis"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="absolute -bottom-6 -right-6 bg-petroleo rounded-[24px] p-6 shadow-xl">
          <p class="text-white text-sm font-bold font-display">¿Y tú?<br/>Puedes sumarte.</p>
        </div>
      </div>
      <div class="space-y-8">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-coral/10 border border-coral/20 text-coral text-xs font-bold uppercase tracking-widest">
          <HeartHandshake class="w-3 h-3" />
          <span>Voluntariado</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-petroleo font-display leading-tight">
          Construyamos juntos.
        </h2>
        <p class="text-petroleo/75 leading-relaxed">
          En Nexis, cualquier miembro puede sumarse como voluntario. No necesitas ser un experto — solo tener ganas de ayudar y ser parte de algo más grande. El voluntariado es el corazón de nuestra comunidad.
        </p>
        <div class="grid sm:grid-cols-2 gap-3">
          {volunteerReasons.map((r) => (
            <div class="flex items-center gap-3 text-sm text-petroleo/80">
              <CheckCircle2 class="w-5 h-5 text-jade shrink-0" />
              <span>{r}</span>
            </div>
          ))}
        </div>
        <a href="/contacto?categoria=voluntariado">
          <button class="bg-jade text-white px-8 py-4 rounded-[18px] font-bold text-sm sm:text-base hover:bg-petroleo transition-all shadow-xl shadow-jade/20 flex items-center group cursor-pointer">
            Quiero ser voluntario <ArrowUpRight class="ml-2 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" />
          </button>
        </a>
      </div>
    </div>
  </div>
</section>
